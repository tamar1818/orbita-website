# ==========================================================================
#  ორბიტა — Apache / LiteSpeed კონფიგურაცია (Hostinger)
# ==========================================================================

AddDefaultCharset UTF-8
DirectoryIndex index.html index.php
Options -Indexes -MultiViews

RewriteEngine On

# --- 1. HTTPS -------------------------------------------------------------
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- 2. www -> non-www (ერთი კანონიკური ჰოსტი) ---------------------------
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# --- 3. /index.html, /index.php -> / ---------------------------------------
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+index\.(html|php)[\s?] [NC]
RewriteRule ^ / [R=301,L]

# --- 4. /page.html -> /page (301, დუბლიკატების თავიდან ასაცილებლად) ------
# მხოლოდ GET/HEAD: POST-ის გადამისამართებისას ბრაუზერი მას GET-ად აქცევს და
# ფორმის მონაცემები იკარგება. /api/ და /admin/ საერთოდ არ გადამისამართდება.
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{REQUEST_URI} !^/(api|admin)/
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{REQUEST_URI} !^/(api|admin)/
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# --- 5. ბოლო სლეშის მოცილება (რეალური დირექტორიების გარდა) --------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+?)/+$ /$1 [R=301,L]

# --- 6-. sitemap.xml -> sitemap.php (ყოველთვის აქტუალური) ---------------
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# --- 6a. /work-<slug> -> project.php (CMS-ის დინამიკური პროექტები) ------
RewriteRule ^work-([a-z0-9-]+)/?$ project.php?slug=$1 [L,QSA]

# --- 6a2. /blog/<slug> -> post.php (ბლოგის სტატიები) -------------------
RewriteRule ^blog/([a-z0-9-]+)/?$ post.php?slug=$1 [L,QSA]

# --- 6b. /page -> page.php --------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# --- 6c. /page -> page.html (დარჩენილი სტატიკური გვერდები) -------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

ErrorDocument 404 /404.php

# --- 7. შეკუმშვა ----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# --- 8. ქეშირება ----------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  # CSS/JS იცვლება — მისამართში ?v=… ვერსიაა; ქეში ზომიერი
  ExpiresByType text/css                  "access plus 7 days"
  ExpiresByType application/javascript    "access plus 7 days"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

# --- 9. უსაფრთხოების ჰედერები --------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # გვერდები ყოველთვის ახლიდან მოწმდება — ძველი HTML ძველ CSS/JS-ს აღარ ჩატვირთავს
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# --- 10. შრიფტების MIME ---------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff  .woff
</IfModule>
